# ============================================================
# SiparişAsistanı - .env ÖRNEK (kendi anahtarlarını gir)
# ============================================================

# --- Supabase (ZORUNLU) ---
SUPABASE_URL=https://aavykdxjgxwreohxngmp.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_buraya
SUPABASE_ANON_KEY=anon_key_buraya

# --- API ---
PORT=3001
API_URL=http://localhost:3001

# --- Yedekleme şifrelemesi (ZORUNLU - yoksa yedekleme çalışmaz) ---
# Güçlü bir anahtar kullan (örn: openssl rand -hex 32)
BACKUP_ENCRYPTION_KEY=degistir_bunu_uzun_rastgele_hex_anahtar

# --- DR restore hedefi (OPSİYONEL - restore testi için ayrı Supabase projesi) ---
# Tanımlı DEĞİLSE restore() dry-run döner (yazma yapılmaz, prod güvende).
# Tanımlanırsa SUPABASE_URL ile aynı olmasına izin VERİLMEZ (prod korunur).
# DR_TARGET_URL=https://xxxx.supabase.co
# DR_TARGET_KEY=service_role_key_buraya

# --- AI (DeepSeek + OpenAI) ---
DEEPSEEK_API_KEY=deepseek_api_anahtari
OPENAI_API_KEY=openai_api_anahtari

# --- Ses (ElevenLabs) ---
ELEVENLABS_API_KEY=elevenlabs_api_anahtari

# --- Telefon (NetGSM) ---
NETGSM_USERNAME=netgsm_kullanici_adi
NETGSM_PASSWORD=netgsm_sifre
NETGSM_MSG_HEADER=netgsm_baslik

# --- Instagram (Instagram API with Instagram Login) ---
# Her tenant kendi Meta app / IG hesabı / token bilgilerini api_keys.meta_instagram altında tutar.
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v23.0
INSTAGRAM_TOKEN_REFRESH_URL=https://graph.instagram.com/refresh_access_token
# Sadece dev/test: fake webhook endpoint. Üretimde boş bırakın.
INSTAGRAM_TEST_SECRET=

# Sentry (optional - crash monitoring)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
