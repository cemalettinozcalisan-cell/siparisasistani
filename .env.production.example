# ============================================================
# SiparişAsistanı - Production Environment
# ============================================================

# --- Supabase (ZORUNLU) ---
SUPABASE_URL=https://aavykdxjgxwreohxngmp.supabase.co
SUPABASE_SERVICE_KEY=your-production-service-role-key

# --- Server ---
PORT=3001
API_URL=https://api.siparisasistani.com
CORS_ORIGIN=https://app.siparisasistani.com

# --- AI ---
AI_PRIMARY_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=openai
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# --- Voice ---
VOICE_PRIMARY_PROVIDER=elevenlabs
VOICE_FALLBACK_PROVIDER=openai
ELEVENLABS_API_KEY=your-elevenlabs-key

# --- Telephony ---
TELEPHONY_PROVIDER=netgsm
NETGSM_API_URL=https://api.netgsm.com.tr
NETGSM_USERNAME=your-netgsm-username
NETGSM_PASSWORD=your-netgsm-password
NETGSM_MSG_HEADER=your-netgsm-header

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=production
